{% extends 'partials/base.html.twig' %}

{# Кухня штаба: the menu, and the things the kitchen is about — the local
   suppliers, the Песоченский porcelain the drinks are served in, and the 3D
   printer on the windowsill.

   The two menu lists are lifted unchanged from the old single-page template.
   Both use .menu-list, whose column count follows the available width rather
   than the item count, so items can be added and removed in the admin without
   ever touching CSS. Prices and descriptions are optional and omit their
   element, which is what keeps an unpriced item from leaving a stray gap.

   The cards below the menu use the same .feature-grid alternation as
   Окрестности, but with icons, which is why they are written out here rather
   than routed through cards.html.twig — that template deliberately has no
   editorial section of its own. #}

{% block body %}
<main>

  {% include 'partials/banner.html.twig' %}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">ЧЕМ УГОЩАЕМ</span>
        <h2>{{ page.header.menu_title }}</h2>
        <p class="section-sub">{{ page.header.menu_sub }}</p>
      </div>

      <div class="menu-list">
        {% for item in page.header.menu_items %}
          <article class="menu-item">
            <div class="menu-thumb">
              {% set im = page.media[item.image|default('')] %}
              <img src="{{ im ? im.cropZoom(160, 160).quality(75).url : url('theme://images/placeholder.svg') }}"
                   alt="{{ item.title }}" loading="lazy" decoding="async">
            </div>
            <div class="menu-body">
              <div class="menu-head">
                <h3>{{ item.title }}</h3>
                {% if item.price %}<span class="menu-price">{{ item.price }}</span>{% endif %}
              </div>
              {% if item.text %}<p>{{ item.text }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="subsection">
        <div class="section-head section-head-sm">
          <span class="eyebrow">ДРУГИЕ НАПИТКИ</span>
          <h3>{{ page.header.drinks_title }}</h3>
          <p class="section-sub">{{ page.header.drinks_sub }}</p>
        </div>

        <div class="menu-list">
          {% for item in page.header.drinks_items %}
            <article class="menu-item">
              <div class="menu-thumb">
                {% set im = page.media[item.image|default('')] %}
                <img src="{{ im ? im.cropZoom(160, 160).quality(75).url : url('theme://images/placeholder.svg') }}"
                     alt="{{ item.title }}" loading="lazy" decoding="async">
              </div>
              <div class="menu-body">
                <div class="menu-head">
                  <h3>{{ item.title }}</h3>
                  {% if item.price %}<span class="menu-price">{{ item.price }}</span>{% endif %}
                </div>
                {% if item.text %}<p>{{ item.text }}</p>{% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  {% if page.header.items %}
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{{ page.header.items_eyebrow|default('ЧТО ЕЩЁ') }}</span>
          <h2>{{ page.header.items_title }}</h2>
          {% if page.header.items_sub %}<p class="section-sub">{{ page.header.items_sub }}</p>{% endif %}
        </div>

        <div class="feature-grid">
          {% for item in page.header.items %}
            <article class="feature-card">
              <div class="img-frame img-frame--feature">
                {% set im = page.media[item.image|default('')] %}
                <img src="{{ im ? im.cropZoom(1000, 750).quality(75).url : url('theme://images/placeholder.svg') }}"
                     alt="{{ item.title }}" loading="lazy" decoding="async">
              </div>
              <div class="feature-body">
                {% include 'partials/icon.html.twig' with {name: item.icon} %}
                <h3>{{ item.title }}</h3>
                {% if item.subtitle %}<p class="card-sub">{{ item.subtitle }}</p>{% endif %}
                {% if item.text %}<p>{{ item.text }}</p>{% endif %}
                {% if item.text2 %}<p>{{ item.text2 }}</p>{% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

</main>
{% endblock %}
