{# A named line-icon. Include with:  {% include 'partials/icon.html.twig' with {name: item.icon} %}

   WHY NAMED AND NOT POSITIONAL. These icons used to be a `loop.index == 1..4`
   chain in home.html.twig, inherited from the old CMS, which preserved them
   only by cloning template nodes by index. That had two failures the client
   would have hit: reordering the cards silently swapped their icons, and a
   fifth card rendered with no icon at all. The name is now a field they pick
   from a dropdown, so an icon belongs to its card and travels with it.

   An unknown or empty name renders nothing — no element, no gap. That is what
   makes the icon optional everywhere it is used.

   All are 24×24, stroke-only, stroke-width 2, so they match the brand cup in
   the header. Adding one means adding a case here AND an option in the
   blueprints that offer the field, or the client can never choose it. #}
{% set d = {
  'coffee':  '<path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line>',
  'crate':   '<path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M2 7h20l-2 5H4L2 7z"></path><path d="M12 12V7"></path>',
  'house':   '<path d="M3 11l9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path>',
  'people':  '<circle cx="12" cy="8" r="4"></circle><path d="M4 21v-1a8 8 0 0 1 16 0v1"></path>',
  'book':    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>',
  'printer': '<path d="M6 9V3h12v6"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect>',
  'music':   '<path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle>',
  'film':    '<rect x="2" y="2" width="20" height="20" rx="2.2"></rect><path d="M7 2v20"></path><path d="M17 2v20"></path><path d="M2 12h20"></path><path d="M2 7h5"></path><path d="M2 17h5"></path><path d="M17 17h5"></path><path d="M17 7h5"></path>',
  'game':    '<rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.2"></circle><circle cx="12" cy="12" r="1.2"></circle><circle cx="15.5" cy="15.5" r="1.2"></circle>',
  'leaf':    '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"></path><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"></path>',
  'clock':   '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>'
} %}
{% if name and d[name] is defined %}
  <span class="feature-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ d[name]|raw }}</svg>
  </span>
{% endif %}
