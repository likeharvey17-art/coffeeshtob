{
  // Deployment config for the Cloudflare Worker that serves this site.
  //
  // ⚠ CURRENTLY INERT. This Worker was created through the Cloudflare
  // dashboard, and that build path does not run `wrangler deploy` — so this
  // file is presently just served as a static asset (GET /wrangler.jsonc
  // returns 200) and none of the settings below take effect.
  //
  // To make it live: Cloudflare → the Worker → Settings → Builds → set the
  // deploy command to `npx wrangler deploy`. After that, redeploy and an
  // unknown path should return 404.html instead of an empty 404 body.
  //
  // `name` must match the existing Worker exactly. A typo does not error — it
  // deploys to a *different* Worker, leaving the live site silently stale.
  "name": "coffeeshtob-site-cc",
  "compatibility_date": "2026-09-03",

  "assets": {
    // The repo root is the web root; there is no build step.
    "directory": "./",

    // The reason this file exists: without it Cloudflare answers unknown paths
    // with a bare, empty 404 and never looks at 404.html.
    "not_found_handling": "404-page",

    // Cloudflare's own default, stated explicitly because it has a visible
    // consequence: it 307s /privacy.html to /privacy and /index.html to /.
    // Every internal link, canonical, og:url and sitemap entry therefore uses
    // the extensionless form, so none of them point at a redirect.
    "html_handling": "auto-trim"
  }
}
