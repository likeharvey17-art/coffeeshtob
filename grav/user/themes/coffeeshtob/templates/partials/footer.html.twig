{# Carried over verbatim from the static index.html.

   The #contacts anchor at the very end is a zero-height marker, NOT the footer
   element. Anchoring the footer aligned its top, and the footer is taller than
   a phone screen, so the contact details stayed below the fold and the nav link
   looked like it stopped short. A marker at the document end makes the browser
   clamp to maximum scroll. Keep it zero-height or it adds a gap. #}
<footer class="site-footer">
  <div class="container footer-grid">

    <div class="footer-col footer-brand">
      <a class="brand brand-footer" href="#top">
        <span class="brand-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
        </span>
        <span class="brand-text">
          <strong>Кофештаб</strong>
          <small>РОМАНОВ НА ВОЛГЕ</small>
        </span>
      </a>
      <p>{{ page.header.footer_about }}</p>
    </div>

    <div class="footer-col">
      <h4>ГДЕ МЫ НАХОДИМСЯ</h4>
      <p>{{ page.header.address }}</p>
      <p class="note">{{ page.header.address_note }}</p>
      <a class="link-arrow" href="https://yandex.ru/maps/?text=%D0%A2%D1%83%D1%82%D0%B0%D0%B5%D0%B2%2C%20%D0%92%D0%BE%D0%BB%D0%B6%D1%81%D0%BA%D0%B0%D1%8F%20%D0%BD%D0%B0%D0%B1%D0%B5%D1%80%D0%B5%D0%B6%D0%BD%D0%B0%D1%8F%2C%2019" target="_blank" rel="noopener">Открыть на Яндекс.Картах →</a>
    </div>

    <div class="footer-col">
      <h4>НАВИГАЦИЯ</h4>
      <nav class="footer-nav">
        <a href="#about">О штабе</a>
        <a href="#menu">Меню</a>
        <a href="#life">Жизнь штаба</a>
        <a href="#schedule">График</a>
        <a href="#guests">Гостям города</a>
        <a href="#contacts">Контакты</a>
      </nav>
    </div>

    <div class="footer-col" id="social">
      <h4>МЫ НА СВЯЗИ</h4>
      {# One field drives both. Written as two literals, editing the number in the
         admin would change what the footer *shows* while the link kept dialling
         the old one — the kind of break nobody notices until a customer calls
         the wrong number. #}
      {% set tel = page.header.phone|replace({' ': '', '(': '', ')': '', '-': ''}) %}
      <a class="footer-phone" href="tel:{{ tel }}">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
        <span>{{ page.header.phone }}</span>
      </a>
      <div class="social-links">
        <a href="https://t.me/coffeeshtob" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"></path><path d="M22 2 15 22l-4-9-9-4 20-7z"></path></svg>
          Telegram-канал
        </a>
        <a href="https://vk.com/coffeeshtob" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect><path d="M6.6 8.9l2.3 6.2 2.3-6.2"></path><path d="M14.3 8.9v6.2"></path><path d="M17.9 8.9l-3.6 3.1 3.6 3.1"></path></svg>
          ВКонтакте
        </a>
        <a href="https://romanovnavolge.ru/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"></path></svg>
          Гид по Романову
        </a>
      </div>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© 2026 «Кофештаб»</span>
      <span class="dot">·</span>
      <span>Волжская набережная, 19 · Ярославская область, Тутаев, левый берег</span>
      <span class="dot">·</span>
      <a class="footer-legal-link" href="/privacy">Политика конфиденциальности</a>
    </div>
  </div>

  <!-- The «Контакты» anchor sits at the very end of the document, not on the
       <footer> element. Anchoring the footer aligned its *top*, which on a
       footer this tall left the contact details and social links below the
       fold — the link looked like it hadn't gone far enough. Pointing at a
       marker here means the browser scrolls its top into view, clamps to the
       maximum scroll, and lands at the actual bottom. Native anchor navigation
       does it, so it inherits the page's smooth scrolling and needs no JS. -->
  <div id="contacts" class="anchor-end" aria-hidden="true"></div>
</footer>
