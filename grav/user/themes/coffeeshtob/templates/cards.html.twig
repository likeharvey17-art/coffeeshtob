{% extends 'partials/base.html.twig' %}

{# The workhorse template: Окрестности, Гостиная, Команда, Мастера and Сказки
   are all "a banner, some words, then a list of things with photos", so they
   share one template and one blueprint rather than five near-copies.

   Grav picks a template from the page FILENAME, which is why all five pages are
   a file called cards.md. Renaming one to match its folder would send it to
   default.html.twig and render a blank body — that is exactly how the very
   first activation of this theme failed.

   ONE LIST, THREE LAYOUTS, chosen per page by `layout` in the front matter:

     alt   — full-width rows, photo alternating right/left down the page. For a
             handful of substantial entries with real photos (Окрестности).
     wide  — one big 16:10 photo per entry, stacked. For long text (Сказки).
     grid  — a compact auto-filling grid. For many short entries: people,
             masters, the things in the Гостиная.

   `grid` follows .menu-list's rule — the column count comes from the available
   width, never from the item count — so a page can gain or lose entries in the
   admin and never produce an orphan row.

   Every field except title is optional and simply omits its element, so a
   placeholder entry with nothing but a name renders cleanly rather than leaving
   empty tags behind. Images fall back to the theme placeholder the same way
   they do everywhere else. #}

{% set layout = page.header.layout|default('alt') %}

{% block body %}
<main>

  {% include 'partials/banner.html.twig' %}

  <section class="section">
    <div class="container">

      {% if page.header.lead %}
        <div class="section-head">
          <h2>{{ page.header.lead_title }}</h2>
          {% for para in page.header.lead|split("\n") %}
            {% if para|trim %}<p class="section-sub">{{ para|trim }}</p>{% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if layout == 'alt' %}
        <div class="feature-grid">
          {% for item in page.header.items %}
            <article class="feature-card">
              <div class="img-frame img-frame--feature">
                {% set im = page.media[item.image|default('')] %}
                <img src="{{ im ? im.cropZoom(1000, 750).quality(75).url : url('theme://images/placeholder.svg') }}"
                     alt="{{ item.title }}" loading="lazy" decoding="async">
              </div>
              <div class="feature-body">
                {% include 'partials/icon.html.twig' with {name: item.icon} %}
                <h3>{{ item.title }}</h3>
                {% if item.subtitle %}<p class="card-sub">{{ item.subtitle }}</p>{% endif %}
                {% if item.text %}<p>{{ item.text }}</p>{% endif %}
                {% if item.text2 %}<p>{{ item.text2 }}</p>{% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

      {% elseif layout == 'wide' %}
        <div class="life-grid">
          {% for item in page.header.items %}
            <article class="life-card">
              <div class="img-frame img-frame--wide">
                {% set im = page.media[item.image|default('')] %}
                <img src="{{ im ? im.cropZoom(1100, 688).quality(75).url : url('theme://images/placeholder.svg') }}"
                     alt="{{ item.title }}" loading="lazy" decoding="async">
              </div>
              {% include 'partials/icon.html.twig' with {name: item.icon} %}
              <h3>{{ item.title }}</h3>
              {% if item.subtitle %}<p class="card-sub">{{ item.subtitle }}</p>{% endif %}
              {% if item.text %}<p>{{ item.text }}</p>{% endif %}
              {% if item.text2 %}<p>{{ item.text2 }}</p>{% endif %}
            </article>
          {% endfor %}
        </div>

      {% else %}
        <div class="card-grid">
          {% for item in page.header.items %}
            <article class="card-item">
              <div class="img-frame img-frame--card">
                {% set im = page.media[item.image|default('')] %}
                <img src="{{ im ? im.cropZoom(760, 570).quality(75).url : url('theme://images/placeholder.svg') }}"
                     alt="{{ item.title }}" loading="lazy" decoding="async">
              </div>
              {% include 'partials/icon.html.twig' with {name: item.icon} %}
              <h3>{{ item.title }}</h3>
              {% if item.subtitle %}<p class="card-sub">{{ item.subtitle }}</p>{% endif %}
              {% if item.text %}<p>{{ item.text }}</p>{% endif %}
              {% if item.text2 %}<p>{{ item.text2 }}</p>{% endif %}
            </article>
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </section>

  {# An optional closing note — used by Окрестности to hand visitors off to the
     tourist guide, and available to any page that wants a last word. The link
     is only rendered when both its fields are filled, so a half-filled form
     cannot produce a bare arrow pointing nowhere. #}
  {% if page.header.outro_title or page.header.outro_text %}
    <section class="section section-alt">
      <div class="container">
        <div class="info-grid">
          <article class="info-card info-card--wide">
            {% if page.header.outro_title %}<h3>{{ page.header.outro_title }}</h3>{% endif %}
            {% if page.header.outro_text %}<p>{{ page.header.outro_text }}</p>{% endif %}
            {% if page.header.outro_link_url and page.header.outro_link_text %}
              <a class="link-arrow" href="{{ page.header.outro_link_url }}" target="_blank" rel="noopener">{{ page.header.outro_link_text }} →</a>
            {% endif %}
          </article>
        </div>
      </div>
    </section>
  {% endif %}

</main>
{% endblock %}
