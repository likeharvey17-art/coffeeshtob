{% extends 'partials/base.html.twig' %}

{# STEP 2 OF THE PORT: every piece of copy on this page now comes from
   page.header.*, and blueprints/home.yaml gives the client a Russian-labelled
   form for all of it. Step 1's hardcoded markup is gone.

   Do not "tidy" this markup. Several things in it look wrong and are not:
   the class names .feature-card/.menu-card/.life-card are historical and carry
   no box styling, the grid gaps are the only thing separating entries, and the
   hero's auto-margin thirds are what centre the buttons at any viewport.

   THREE CONVENTIONS USED THROUGHOUT, all deliberate:

   1. Images are page media — a bare filename in the front matter, resolved
      against user/pages/01.home/. `page.media[name]` returns null for a name
      that is missing or empty, so every image falls back to the theme's
      placeholder rather than rendering a broken <img>. Three menu items ship
      with an empty value for exactly that reason; they are waiting on photos.

   2. The inline SVGs (feature icons, the badge pin) stay hardcoded. They are
      four *different* drawings tied to card position, not content — the old CMS
      preserved them only by cloning template nodes by index, which is precisely
      the fragile mechanism this replaces. A fifth feature card gets no icon,
      which is correct: it should be added deliberately, not silently reused.

   3. Multi-paragraph text splits on newlines and wraps each line in <p>. That
      keeps .about-text's flex gap working — the old render.js used textContent
      for single-paragraph values, which destroyed the <p> children the gap
      relies on, and template-literal interpolation for multi, which nested a
      <p> inside a <p>. Twig autoescapes, so a `<` typed in the admin is text. #}

{% block body %}
<main>

  <!-- HERO -->
  <section class="hero">
    {% set hero_img = page.media[page.header.hero_image|default('')] %}
    <img class="hero-bg" src="{{ hero_img ? hero_img.cropZoom(1400, 880).quality(65).url : url('theme://images/placeholder.svg') }}"
         alt="" loading="eager" decoding="async">
    <div class="hero-overlay"></div>
    <div class="hero-top">
      <p class="badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path>
          <circle cx="12" cy="9.5" r="2.3"></circle>
        </svg>
        {{ page.header.hero_badge }}
      </p>
    </div>

    <div class="hero-inner">
      <h1>{{ page.header.hero_title }}</h1>
      <p class="hero-lead">{{ page.header.hero_lead }}</p>
      <div class="hero-actions">
        <a href="#menu" class="btn btn-accent">Что у нас есть</a>
        <a href="#about" class="btn btn-ghost">О штабе</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">О ШТАБЕ</span>
        <h2>{{ page.header.about_title }}</h2>
      </div>

      <div class="about-grid">
        <div class="img-frame img-frame--about">
          {% set about_img = page.media[page.header.about_image|default('')] %}
          <img src="{{ about_img ? about_img.cropZoom(1040, 780).quality(80).url : url('theme://images/placeholder.svg') }}"
               alt="Фото: купеческий дом на Волжской набережной" loading="lazy" decoding="async">
        </div>
        <div class="about-text">
          {% for para in page.header.about_text|split("\n") %}
            {% if para|trim %}<p>{{ para|trim }}</p>{% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="feature-grid">
        {% for item in page.header.features %}
          <article class="feature-card">
            <div class="img-frame img-frame--square">
              {% set im = page.media[item.image|default('')] %}
              <img src="{{ im ? im.cropZoom(800, 800).quality(80).url : url('theme://images/placeholder.svg') }}"
                   alt="{{ item.title }}" loading="lazy" decoding="async">
            </div>
            {# Icons are positional, not content — see note 2 at the top. #}
            {% if loop.index == 1 %}
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M2 7h20l-2 5H4L2 7z"></path><path d="M12 12V7"></path></svg>
              </span>
            {% elseif loop.index == 2 %}
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path></svg>
              </span>
            {% elseif loop.index == 3 %}
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21v-1a8 8 0 0 1 16 0v1"></path></svg>
              </span>
            {% elseif loop.index == 4 %}
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              </span>
            {% endif %}
            <h3>{{ item.title }}</h3>
            <p>{{ item.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- MENU -->
  <section class="section section-alt" id="menu">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">ЧЕМ УГОЩАЕМ</span>
        <h2>{{ page.header.menu_title }}</h2>
        <p class="section-sub">{{ page.header.menu_sub }}</p>
      </div>

      <div class="menu-list">
        {% for item in page.header.menu_items %}
          <article class="menu-item">
            <div class="menu-thumb">
              {% set im = page.media[item.image|default('')] %}
              <img src="{{ im ? im.cropZoom(160, 160).quality(80).url : url('theme://images/placeholder.svg') }}"
                   alt="{{ item.title }}" loading="lazy" decoding="async">
            </div>
            <div class="menu-body">
              <div class="menu-head">
                <h3>{{ item.title }}</h3>
                {# Prices are optional: an unpriced item shows no stray gap. #}
                {% if item.price %}<span class="menu-price">{{ item.price }}</span>{% endif %}
              </div>
              {% if item.text %}<p>{{ item.text }}</p>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="subsection">
        <div class="section-head section-head-sm">
          <span class="eyebrow">ДРУГИЕ НАПИТКИ</span>
          <h3>{{ page.header.drinks_title }}</h3>
          <p class="section-sub">{{ page.header.drinks_sub }}</p>
        </div>

        <div class="menu-list">
          {% for item in page.header.drinks_items %}
            <article class="menu-item">
              <div class="menu-thumb">
                {% set im = page.media[item.image|default('')] %}
                <img src="{{ im ? im.cropZoom(160, 160).quality(80).url : url('theme://images/placeholder.svg') }}"
                     alt="{{ item.title }}" loading="lazy" decoding="async">
              </div>
              <div class="menu-body">
                <div class="menu-head">
                  <h3>{{ item.title }}</h3>
                  {% if item.price %}<span class="menu-price">{{ item.price }}</span>{% endif %}
                </div>
                {% if item.text %}<p>{{ item.text }}</p>{% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- LIFE -->
  <section class="section" id="life">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">ЧЕМ ЖИВЕМ</span>
        <h2>{{ page.header.life_title }}</h2>
        <p class="section-sub">{{ page.header.life_sub }}</p>
      </div>

      <div class="life-grid">
        {% for item in page.header.life_items %}
          <article class="life-card">
            <div class="img-frame img-frame--wide">
              {% set im = page.media[item.image|default('')] %}
              <img src="{{ im ? im.cropZoom(1100, 688).quality(80).url : url('theme://images/placeholder.svg') }}"
                   alt="{{ item.title }}" loading="lazy" decoding="async">
            </div>
            <h3>{{ item.title }}</h3>
            {% if item.text %}<p>{{ item.text }}</p>{% endif %}
            {# The second paragraph existed in the static markup but the old CMS
               could not reach it — it was template text cloned by index. It is
               a real field now, and optional. #}
            {% if item.text2 %}<p>{{ item.text2 }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- SCHEDULE / GUESTS -->
  <section class="section section-alt" id="schedule">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">КАК НАС НАЙТИ</span>
        <h2>{{ page.header.schedule_title }}</h2>
        <p class="section-sub">{{ page.header.schedule_sub }}</p>
      </div>

      <div class="info-grid">
        <article class="info-card info-card--panel">
          <h3>{{ page.header.hours_title }}</h3>
          <dl class="schedule-list">
            {% for row in page.header.hours %}
              <div>
                <dt>{{ row.label }}</dt>
                <dd>{{ row.time }}</dd>
              </div>
            {% endfor %}
          </dl>
          {% if page.header.hours_note %}
            <p class="note">{{ page.header.hours_note }}</p>
          {% endif %}
        </article>

        <article class="info-card" id="guests">
          <h3>{{ page.header.guests_title }}</h3>
          <p>{{ page.header.guests_text }}</p>
          <a class="link-arrow" href="https://romanovnavolge.ru/" target="_blank" rel="noopener">Туристический гид «Романов на Волге» →</a>
        </article>

        <article class="info-card info-card--wide">
          <h3>{{ page.header.ferry_title }}</h3>
          <p>{{ page.header.ferry_text }}</p>
        </article>
      </div>
    </div>
  </section>

</main>
{% endblock %}
