{% extends 'partials/base.html.twig' %}

{# The landing page. It used to be the WHOLE site — five sections and every
   field on one scroll. Those sections are now seven real pages, and what is
   left here is the hero, a short introduction, and a way in to each section.

   THE SECTION GRID IS GENERATED FROM THE PAGE TREE, not typed out. Each page
   supplies its own card image and one-line teaser, so renaming a page,
   reordering the folders or adding an eighth section updates this grid with no
   edit here and no chance of home advertising a section that no longer exists.
   It is the same `pages.children.visible` the nav uses, for the same reason.

   Note the images resolve against EACH page's own media (`p.media`), not this
   one's — page media in Grav is scoped to the page folder, so a card photo for
   Кухня lives in the Кухня folder where the client uploads it. #}

{% block body %}
<main>

  <!-- HERO -->
  <section class="hero">
    {% set hero_img = page.media[page.header.hero_image|default('')] %}
    <img class="hero-bg" src="{{ hero_img ? hero_img.cropZoom(1400, 880).quality(65).url : url('theme://images/placeholder.svg') }}"
         alt="" loading="eager" decoding="async">
    <div class="hero-overlay"></div>
    <div class="hero-top">
      <p class="badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path>
          <circle cx="12" cy="9.5" r="2.3"></circle>
        </svg>
        {{ page.header.hero_badge }}
      </p>
    </div>

    <div class="hero-inner">
      <h1>{{ page.header.hero_title }}</h1>
      <p class="hero-lead">{{ page.header.hero_lead }}</p>
      {# The buttons used to be in-page anchors. They point at real pages now,
         and the targets are fields so the client can send people wherever the
         season calls for — the menu in summer, the events page before a
         Квартирник. Each renders only when it has both a label and a link. #}
      <div class="hero-actions">
        {% if page.header.cta1_text and page.header.cta1_url %}
          <a href="{{ base_url }}{{ page.header.cta1_url }}" class="btn btn-accent">{{ page.header.cta1_text }}</a>
        {% endif %}
        {% if page.header.cta2_text and page.header.cta2_url %}
          <a href="{{ base_url }}{{ page.header.cta2_url }}" class="btn btn-ghost">{{ page.header.cta2_text }}</a>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">О ШТАБЕ</span>
        <h2>{{ page.header.about_title }}</h2>
      </div>

      <div class="about-grid">
        <div class="img-frame img-frame--about">
          {% set about_img = page.media[page.header.about_image|default('')] %}
          <img src="{{ about_img ? about_img.cropZoom(1040, 780).quality(75).url : url('theme://images/placeholder.svg') }}"
               alt="{{ page.header.about_title }}" loading="lazy" decoding="async">
        </div>
        <div class="about-text">
          {# A blank line in the admin starts a new paragraph. Splitting and
             wrapping each line keeps .about-text's flex gap working — the old
             render.js used textContent, which destroyed the <p> children the
             gap relies on. Twig autoescapes, so a `<` typed in the admin is
             text, not markup. #}
          {% for para in page.header.about_text|split("\n") %}
            {% if para|trim %}<p>{{ para|trim }}</p>{% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTIONS -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">РАЗДЕЛЫ</span>
        <h2>{{ page.header.sections_title }}</h2>
        {% if page.header.sections_sub %}<p class="section-sub">{{ page.header.sections_sub }}</p>{% endif %}
      </div>

      <div class="card-grid section-grid">
        {% for p in pages.children.visible %}
          <a class="card-item card-link" href="{{ p.url }}">
            <div class="img-frame img-frame--card">
              {% set im = p.media[p.header.card_image|default('')] %}
              <img src="{{ im ? im.cropZoom(760, 570).quality(75).url : url('theme://images/placeholder.svg') }}"
                   alt="{{ p.title }}" loading="lazy" decoding="async">
            </div>
            <h3>{{ p.title }}</h3>
            {% if p.header.card_teaser %}<p>{{ p.header.card_teaser }}</p>{% endif %}
            <span class="link-arrow" aria-hidden="true">Смотреть →</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

</main>

{# Structured data for search, built from the fields the site actually renders
   so it cannot quietly contradict them.

   The hours moved to /kontakty with the rest of the schedule, so this reaches
   across for them. That lookup is the one cross-page dependency in the theme:
   rename or reroute that page and «открыто до 19:00» silently vanishes from
   search results — which is invisible from the site itself. It fails safe
   (no page, no property) rather than emitting stale hours, and the CI check
   asserts the route still resolves.

   days/opens/closes are optional per row. A row missing any of them is skipped,
   and with no qualifying row the property is omitted entirely: an absent rich
   result is a small loss where a wrong one sends people to a closed café.

   json_encode does the escaping. Building this by hand with string
   concatenation is how an apostrophe in a business name silently invalidates
   the whole block. #}
{% set kontakty = pages.find('/kontakty') %}
{% set opening = [] %}
{% if kontakty %}
  {% for row in kontakty.header.hours %}
    {% if row.days and row.opens and row.closes %}
      {% set opening = opening|merge([{
        '@type': 'OpeningHoursSpecification',
        'dayOfWeek': row.days,
        'opens': row.opens,
        'closes': row.closes
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set schema = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  'name': 'Кофештаб «Романов на Волге»',
  'description': page.header.seo_description,
  'url': base_url_absolute ~ '/',
  'image': base_url_absolute ~ url('theme://images/og-image.jpg'),
  'telephone': theme.phone|replace({' ': '', '(': '', ')': '', '-': ''}),
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': 'Волжская набережная, 19',
    'addressLocality': 'Тутаев',
    'addressRegion': 'Ярославская область',
    'addressCountry': 'RU'
  },
  'sameAs': ['https://t.me/coffeeshtob', 'https://vk.com/coffeeshtob']
} %}
{% if opening %}{% set schema = schema|merge({'openingHoursSpecification': opening}) %}{% endif %}
<script type="application/ld+json">{{ schema|json_encode|raw }}</script>
{% endblock %}
